# ==============================================================================
# AWS Bedrock Configuration (Template)
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control or share in chat logs.
# ==============================================================================

# AWS Region where Claude Haiku 4.5 is available
AWS_DEFAULT_REGION=ap-southeast-1

# AWS Credentials (Leave empty if using AWS SSO, IAM roles, or ~/.aws/credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Model ID on AWS Bedrock (Claude Haiku 4.5 - official model)
BEDROCK_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# Project budget limit in USD
BUDGET_HARD_STOP_USD=15.0
